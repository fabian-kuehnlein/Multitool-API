{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "MultitoolApi",
    "Audience": "MultitoolFrontend"
  },
  "CronJobs": {
    "CleanUpPastEvents": "0 3 * * *",
    "CleanUpPastEventsMonths": 3,
    "CleanUpPastTodos": "0 3 * * *",
    "CleanUpPastTodosDays": 7
  }
}
